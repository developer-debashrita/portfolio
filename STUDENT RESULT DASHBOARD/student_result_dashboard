<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Student Result Dashboard</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    :root {
      --bg:        #0d0f14;
      --surface:   #13161e;
      --card:      #191d28;
      --border:    #252a38;
      --accent:    #6c63ff;
      --accent2:   #00d4aa;
      --accent3:   #ff6b6b;
      --accent4:   #ffd166;
      --text:      #e8eaf2;
      --muted:     #6b7094;
      --pass:      #00d4aa;
      --fail:      #ff6b6b;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Space Grotesk', sans-serif;
      min-height: 100vh;
      padding: 0;
    }

    /* ─── TOP BAR ─────────────────────────────────── */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 18px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .logo-dot {
      width: 10px; height: 10px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 12px var(--accent);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .semester-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      color: var(--accent2);
      background: rgba(0,212,170,0.1);
      border: 1px solid rgba(0,212,170,0.25);
      padding: 5px 12px;
      border-radius: 20px;
    }

    /* ─── STUDENT SELECTOR ────────────────────────── */
    .student-select-bar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 14px 28px;
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .student-select-bar label {
      font-size: 0.8rem;
      color: var(--muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    #studentSelect {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.9rem;
      padding: 9px 16px;
      border-radius: 8px;
      outline: none;
      cursor: pointer;
      transition: border-color 0.2s;
    }

    #studentSelect:focus { border-color: var(--accent); }

    /* ─── MAIN LAYOUT ─────────────────────────────── */
    main {
      padding: 28px;
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      gap: 24px;
    }

    /* ─── STUDENT PROFILE CARD ────────────────────── */
    .profile-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px 28px;
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }

    .avatar {
      width: 70px; height: 70px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem;
      font-weight: 700;
      flex-shrink: 0;
      position: relative;
    }

    .avatar::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      z-index: -1;
      opacity: 0.35;
      filter: blur(6px);
    }

    .profile-info { flex: 1; }

    .profile-info h2 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .profile-meta {
      display: flex;
      gap: 20px;
      margin-top: 6px;
      flex-wrap: wrap;
    }

    .profile-meta span {
      font-size: 0.78rem;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
    }

    .profile-meta span strong {
      color: var(--text);
      font-weight: 500;
    }

    .gpa-block {
      text-align: right;
    }

    .gpa-value {
      font-size: 2.8rem;
      font-weight: 700;
      font-family: 'DM Mono', monospace;
      letter-spacing: -0.04em;
      line-height: 1;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .gpa-label {
      font-size: 0.7rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 2px;
    }

    /* ─── KPI ROW ─────────────────────────────────── */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 16px;
    }

    .kpi {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px 20px 16px;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s;
    }

    .kpi:hover { border-color: var(--accent); transform: translateY(-2px); }

    .kpi::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      border-radius: 14px 14px 0 0;
    }

    .kpi.c1::before { background: var(--accent); }
    .kpi.c2::before { background: var(--accent2); }
    .kpi.c3::before { background: var(--accent4); }
    .kpi.c4::before { background: var(--accent3); }

    .kpi-label {
      font-size: 0.7rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
    }

    .kpi-value {
      font-size: 2rem;
      font-weight: 700;
      font-family: 'DM Mono', monospace;
      letter-spacing: -0.03em;
      margin-top: 6px;
      line-height: 1;
    }

    .kpi.c1 .kpi-value { color: var(--accent); }
    .kpi.c2 .kpi-value { color: var(--accent2); }
    .kpi.c3 .kpi-value { color: var(--accent4); }
    .kpi.c4 .kpi-value { color: var(--accent3); }

    .kpi-sub {
      font-size: 0.72rem;
      color: var(--muted);
      margin-top: 4px;
    }

    /* ─── CHARTS GRID ─────────────────────────────── */
    .charts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    @media(max-width: 760px) { .charts-grid { grid-template-columns: 1fr; } }

    .chart-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
    }

    .chart-card.wide { grid-column: 1 / -1; }

    .chart-title {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 18px;
    }

    .chart-wrap {
      position: relative;
      height: 220px;
    }

    .chart-wrap.tall { height: 260px; }

    /* ─── SUBJECT TABLE ───────────────────────────── */
    .table-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }

    .table-header {
      padding: 20px 24px 16px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .table-header h3 {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
    }

    .pass-rate {
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      color: var(--accent2);
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead tr { background: rgba(108,99,255,0.06); }

    th {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      font-weight: 600;
      padding: 12px 20px;
      text-align: left;
    }

    td {
      padding: 13px 20px;
      font-size: 0.88rem;
      border-top: 1px solid var(--border);
    }

    tbody tr { transition: background 0.15s; }
    tbody tr:hover { background: rgba(255,255,255,0.03); }

    .subject-name { font-weight: 500; }
    .marks-mono { font-family: 'DM Mono', monospace; }

    .grade-badge {
      display: inline-block;
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      font-weight: 500;
      padding: 3px 10px;
      border-radius: 6px;
    }

    .grade-A  { background: rgba(0,212,170,0.12); color: #00d4aa; }
    .grade-B  { background: rgba(108,99,255,0.14); color: #9c95ff; }
    .grade-C  { background: rgba(255,209,102,0.14); color: #ffd166; }
    .grade-D  { background: rgba(255,200,100,0.1); color: #ffb347; }
    .grade-F  { background: rgba(255,107,107,0.14); color: #ff6b6b; }

    .status-pass { color: var(--pass); font-size: 0.78rem; font-weight: 600; font-family: 'DM Mono', monospace; }
    .status-fail { color: var(--fail); font-size: 0.78rem; font-weight: 600; font-family: 'DM Mono', monospace; }

    .bar-bg {
      background: var(--border);
      border-radius: 4px;
      height: 6px;
      width: 100px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: 4px;
      transition: width 0.6s ease;
    }

    /* ─── PERFORMANCE METER ───────────────────────── */
    .perf-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }

    .perf-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
    }

    .perf-label {
      font-size: 0.7rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .progress-track {
      background: var(--border);
      border-radius: 6px;
      height: 10px;
      overflow: hidden;
      margin-bottom: 6px;
    }

    .progress-fill {
      height: 100%;
      border-radius: 6px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      transition: width 0.8s cubic-bezier(.25,.8,.25,1);
    }

    .progress-fill.warn { background: linear-gradient(90deg, var(--accent4), #ff9a3c); }
    .progress-fill.bad  { background: linear-gradient(90deg, var(--accent3), #c0392b); }

    .progress-value {
      font-family: 'DM Mono', monospace;
      font-size: 1.3rem;
      font-weight: 500;
      color: var(--text);
    }

    /* ─── FOOTER ──────────────────────────────────── */
    footer {
      text-align: center;
      padding: 28px;
      color: var(--muted);
      font-size: 0.75rem;
      font-family: 'DM Mono', monospace;
    }
  </style>
</head>
<body>

<header>
  <div class="logo">
    <div class="logo-dot"></div>
    ResultScope
  </div>
  <div class="header-right">
    <span class="semester-badge">SEM 4 · 2025–26</span>
  </div>
</header>

<div class="student-select-bar">
  <label>Student</label>
  <select id="studentSelect" onchange="loadStudent()">
    <option value="0">Aanya Sharma — CS-2201</option>
    <option value="1">Rohan Mehta — CS-2202</option>
    <option value="2">Priya Nair — CS-2203</option>
  </select>
</div>

<main>
  <!-- Profile -->
  <div class="profile-card" id="profileCard">
    <div class="avatar" id="avatarEl">AS</div>
    <div class="profile-info">
      <h2 id="studentName">Aanya Sharma</h2>
      <div class="profile-meta">
        <span>Roll No: <strong id="rollNo">CS-2201</strong></span>
        <span>Branch: <strong id="branch">Computer Science</strong></span>
        <span>Year: <strong>2nd Year</strong></span>
      </div>
    </div>
    <div class="gpa-block">
      <div class="gpa-value" id="gpaVal">8.6</div>
      <div class="gpa-label">CGPA</div>
    </div>
  </div>

  <!-- KPIs -->
  <div class="kpi-row">
    <div class="kpi c1">
      <div class="kpi-label">Total Marks</div>
      <div class="kpi-value" id="totalMarks">562</div>
      <div class="kpi-sub">out of 700</div>
    </div>
    <div class="kpi c2">
      <div class="kpi-label">Percentage</div>
      <div class="kpi-value" id="percentage">80.3%</div>
      <div class="kpi-sub">semester average</div>
    </div>
    <div class="kpi c3">
      <div class="kpi-label">Subjects Passed</div>
      <div class="kpi-value" id="passCount">7</div>
      <div class="kpi-sub">out of 7 subjects</div>
    </div>
    <div class="kpi c4">
      <div class="kpi-label">Highest Score</div>
      <div class="kpi-value" id="highestScore">94</div>
      <div class="kpi-sub" id="highestSubject">Data Structures</div>
    </div>
  </div>

  <!-- Charts -->
  <div class="charts-grid">
    <div class="chart-card wide">
      <div class="chart-title">Marks per Subject</div>
      <div class="chart-wrap tall">
        <canvas id="barChart"></canvas>
      </div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Grade Distribution</div>
      <div class="chart-wrap">
        <canvas id="doughnutChart"></canvas>
      </div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Performance Radar</div>
      <div class="chart-wrap">
        <canvas id="radarChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Subject Table -->
  <div class="table-card">
    <div class="table-header">
      <h3>Subject-wise Results</h3>
      <span class="pass-rate" id="passRate">100% pass rate</span>
    </div>
    <table>
      <thead>
        <tr>
          <th>Subject</th>
          <th>Obtained</th>
          <th>Max</th>
          <th>Grade</th>
          <th>Score</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody id="resultBody"></tbody>
    </table>
  </div>

  <!-- Progress bars -->
  <div class="perf-row" id="perfRow"></div>
</main>

<footer>ResultScope Dashboard · Academic Year 2025–26 · Semester IV</footer>

<script>
  const STUDENTS = [
    {
      name: "Aanya Sharma", roll: "CS-2201", initials: "AS", branch: "Computer Science", cgpa: 8.6,
      subjects: [
        { name: "Data Structures",       marks: 94, max: 100 },
        { name: "Operating Systems",      marks: 78, max: 100 },
        { name: "DBMS",                   marks: 85, max: 100 },
        { name: "Computer Networks",      marks: 72, max: 100 },
        { name: "Mathematics III",        marks: 88, max: 100 },
        { name: "Software Engineering",   marks: 80, max: 100 },
        { name: "Theory of Computation",  marks: 65, max: 100 },
      ]
    },
    {
      name: "Rohan Mehta", roll: "CS-2202", initials: "RM", branch: "Computer Science", cgpa: 7.4,
      subjects: [
        { name: "Data Structures",        marks: 70, max: 100 },
        { name: "Operating Systems",      marks: 58, max: 100 },
        { name: "DBMS",                   marks: 76, max: 100 },
        { name: "Computer Networks",      marks: 65, max: 100 },
        { name: "Mathematics III",        marks: 44, max: 100 },
        { name: "Software Engineering",   marks: 83, max: 100 },
        { name: "Theory of Computation",  marks: 52, max: 100 },
      ]
    },
    {
      name: "Priya Nair", roll: "CS-2203", initials: "PN", branch: "Computer Science", cgpa: 9.1,
      subjects: [
        { name: "Data Structures",        marks: 97, max: 100 },
        { name: "Operating Systems",      marks: 91, max: 100 },
        { name: "DBMS",                   marks: 88, max: 100 },
        { name: "Computer Networks",      marks: 93, max: 100 },
        { name: "Mathematics III",        marks: 95, max: 100 },
        { name: "Software Engineering",   marks: 86, max: 100 },
        { name: "Theory of Computation",  marks: 79, max: 100 },
      ]
    }
  ];

  const PASS_MARK = 45;

  function gradeOf(pct) {
    if (pct >= 90) return 'A+';
    if (pct >= 75) return 'A';
    if (pct >= 60) return 'B';
    if (pct >= 50) return 'C';
    if (pct >= 45) return 'D';
    return 'F';
  }

  function gradeClass(g) {
    if (g === 'A+' || g === 'A') return 'grade-A';
    if (g === 'B') return 'grade-B';
    if (g === 'C') return 'grade-C';
    if (g === 'D') return 'grade-D';
    return 'grade-F';
  }

  function barColor(pct) {
    if (pct >= 75) return '#00d4aa';
    if (pct >= 50) return '#ffd166';
    return '#ff6b6b';
  }

  let barChart, doughnutChart, radarChart;

  function loadStudent() {
    const idx = +document.getElementById('studentSelect').value;
    const s = STUDENTS[idx];
    const subjects = s.subjects;

    // Profile
    document.getElementById('avatarEl').textContent = s.initials;
    document.getElementById('studentName').textContent = s.name;
    document.getElementById('rollNo').textContent = s.roll;
    document.getElementById('branch').textContent = s.branch;
    document.getElementById('gpaVal').textContent = s.cgpa.toFixed(1);

    // KPIs
    const total = subjects.reduce((a, b) => a + b.marks, 0);
    const totalMax = subjects.reduce((a, b) => a + b.max, 0);
    const pct = ((total / totalMax) * 100).toFixed(1);
    const passed = subjects.filter(sub => sub.marks >= PASS_MARK).length;
    const highest = subjects.reduce((a, b) => b.marks > a.marks ? b : a);

    document.getElementById('totalMarks').textContent = total;
    document.getElementById('percentage').textContent = pct + '%';
    document.getElementById('passCount').textContent = passed;
    document.getElementById('highestScore').textContent = highest.marks;
    document.getElementById('highestSubject').textContent = highest.name;

    // Pass rate
    document.getElementById('passRate').textContent =
      Math.round((passed / subjects.length) * 100) + '% pass rate';

    // Table
    const tbody = document.getElementById('resultBody');
    tbody.innerHTML = '';
    subjects.forEach(sub => {
      const p = Math.round((sub.marks / sub.max) * 100);
      const grade = gradeOf(p);
      const pass = sub.marks >= PASS_MARK;
      const row = document.createElement('tr');
      row.innerHTML = `
        <td class="subject-name">${sub.name}</td>
        <td class="marks-mono">${sub.marks}</td>
        <td class="marks-mono">${sub.max}</td>
        <td><span class="grade-badge ${gradeClass(grade)}">${grade}</span></td>
        <td>
          <div style="display:flex;align-items:center;gap:10px">
            <div class="bar-bg"><div class="bar-fill" style="width:${p}%;background:${barColor(p)}"></div></div>
            <span style="font-family:'DM Mono',monospace;font-size:0.78rem;color:var(--muted)">${p}%</span>
          </div>
        </td>
        <td class="${pass ? 'status-pass' : 'status-fail'}">${pass ? '✓ PASS' : '✗ FAIL'}</td>
      `;
      tbody.appendChild(row);
    });

    // Performance bars
    const categories = [
      { label: 'Theory Knowledge', key: [0,6], cap: 100 },
      { label: 'Systems Concepts', key: [1,3], cap: 100 },
      { label: 'Applied Skills',   key: [2,5], cap: 100 },
      { label: 'Mathematics',      key: [4],   cap: 100 },
    ];

    const perfRow = document.getElementById('perfRow');
    perfRow.innerHTML = '';
    categories.forEach(cat => {
      const relevant = cat.key.map(k => subjects[k]);
      const avg = relevant.reduce((a, b) => a + (b.marks / b.max) * 100, 0) / relevant.length;
      const cls = avg >= 75 ? '' : avg >= 50 ? 'warn' : 'bad';
      const div = document.createElement('div');
      div.className = 'perf-card';
      div.innerHTML = `
        <div class="perf-label">${cat.label}</div>
        <div class="progress-track">
          <div class="progress-fill ${cls}" style="width:${avg.toFixed(1)}%"></div>
        </div>
        <div class="progress-value">${avg.toFixed(1)}%</div>
      `;
      perfRow.appendChild(div);
    });

    // Charts
    const labels = subjects.map(s => s.name.split(' ').slice(0,2).join(' '));
    const marks  = subjects.map(s => s.marks);
    const colors = marks.map(m => barColor(Math.round((m/100)*100)));

    // BAR
    if (barChart) barChart.destroy();
    barChart = new Chart(document.getElementById('barChart'), {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: 'Marks',
          data: marks,
          backgroundColor: colors.map(c => c + '99'),
          borderColor: colors,
          borderWidth: 2,
          borderRadius: 7,
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: '#6b7094', font: { family: 'Space Grotesk', size: 11 } }, grid: { color: '#252a38' } },
          y: { min: 0, max: 100, ticks: { color: '#6b7094', font: { family: 'DM Mono', size: 10 } }, grid: { color: '#252a38' } }
        }
      }
    });

    // DOUGHNUT
    const gradeCounts = { 'A+':0, 'A':0, 'B':0, 'C':0, 'D':0, 'F':0 };
    subjects.forEach(sub => { gradeCounts[gradeOf(Math.round((sub.marks/sub.max)*100))]++; });
    const dLabels = Object.keys(gradeCounts).filter(k => gradeCounts[k] > 0);
    const dData   = dLabels.map(k => gradeCounts[k]);
    const dColors = { 'A+':'#00d4aa', 'A':'#34d399', 'B':'#6c63ff', 'C':'#ffd166', 'D':'#ffb347', 'F':'#ff6b6b' };

    if (doughnutChart) doughnutChart.destroy();
    doughnutChart = new Chart(document.getElementById('doughnutChart'), {
      type: 'doughnut',
      data: {
        labels: dLabels,
        datasets: [{
          data: dData,
          backgroundColor: dLabels.map(l => dColors[l] + 'cc'),
          borderColor: dLabels.map(l => dColors[l]),
          borderWidth: 2,
          hoverOffset: 6,
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        cutout: '68%',
        plugins: {
          legend: {
            position: 'right',
            labels: { color: '#6b7094', font: { family: 'DM Mono', size: 11 }, padding: 12 }
          }
        }
      }
    });

    // RADAR
    if (radarChart) radarChart.destroy();
    radarChart = new Chart(document.getElementById('radarChart'), {
      type: 'radar',
      data: {
        labels,
        datasets: [{
          label: s.name.split(' ')[0],
          data: marks,
          backgroundColor: 'rgba(108,99,255,0.15)',
          borderColor: '#6c63ff',
          borderWidth: 2,
          pointBackgroundColor: '#6c63ff',
          pointRadius: 4,
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: '#6b7094', font: { family: 'Space Grotesk', size: 11 } } } },
        scales: {
          r: {
            min: 0, max: 100,
            ticks: { color: '#6b7094', font: { family: 'DM Mono', size: 9 }, backdropColor: 'transparent' },
            grid: { color: '#252a38' },
            pointLabels: { color: '#6b7094', font: { family: 'Space Grotesk', size: 10 } }
          }
        }
      }
    });
  }

  // Init on page load
  loadStudent();
</script>
</body>
</html>
